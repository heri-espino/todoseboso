{
  "schema_version": 1,
  "updated_at": "2026-10-19",
  "methodology": "Historical original 138 known yields; all estimates refer to held-out known parcels, not unknown 59. Different protocols cannot be ranked together.",
  "unit": "t/ha for RMSE, MAE and bias; R² dimensionless",
  "metric_definitions": {
    "rmse": "Raíz del error cuadrático medio; penaliza especialmente grandes errores.",
    "mae": "Error absoluto medio; sensibilidad lineal a los errores.",
    "r2": "Coeficiente de determinación predictivo bajo el protocolo mostrado.",
    "bias": "Promedio de (predicho − observado); cero indica ausencia de sesgo medio, no ausencia de error."
  },
  "protocols": [
    {
      "id": "fresh_97_41",
      "title": "97/41 · 16 particiones",
      "short": "97/41",
      "explain": "Promedios de 16 particiones con 97 cosechas de entrenamiento y 41 de evaluación; las etiquetas corresponden a las mismas 138 parcelas reutilizadas. No es LOOCV.",
      "takeaway": "Esta batería fue diseñada para una comparación compatible de las 10 arquitecturas enumeradas. Diferencias pequeñas de RMSE no prueban superioridad."
    },
    {
      "id": "random",
      "title": "Aleatoria · 10 repeticiones",
      "short": "Aleatoria",
      "explain": "Diez repeticiones de predicciones completas fuera de muestra sobre 138 parcelas. Cada repetición produce su propia métrica, después promediada; no son 1,380 parcelas independientes.",
      "takeaway": "Error bajo particiones aleatorias; no mediría necesariamente transferencia a municipios no vistos."
    },
    {
      "id": "climate_profile",
      "title": "Por perfil climático",
      "short": "Clima",
      "explain": "Validación dejando fuera perfiles climáticos completos. Se examina transferencia entre condiciones agroclimáticas, usando las 138 etiquetas originales.",
      "takeaway": "Excluye perfiles de lluvia/vegetación compartidos; puede resultar más difícil que una partición aleatoria."
    },
    {
      "id": "municipality",
      "title": "Por municipio",
      "short": "Municipio",
      "explain": "Cinco folds agrupados territorialmente por municipios. El ensayo estudia transferencia entre municipios dentro del conjunto de estudio.",
      "takeaway": "No debe interpretarse como una garantía de generalización a cualquier municipio de México."
    },
    {
      "id": "spatial",
      "title": "Por bloque espacial",
      "short": "Espacial",
      "explain": "Cinco folds agrupados por bloques espaciales: entrenar lejos del bloque evaluado cambia el problema de predicción.",
      "takeaway": "Un RMSE menor en aleatoria puede coexistir con errores elevados cuando se dejan fuera regiones completas."
    }
  ],
